# Local assessment settings only. No production credentials are needed.
POSTGRES_DB=customer_insights
POSTGRES_USER=assessment
POSTGRES_PASSWORD=assessment_local_only
POSTGRES_PORT=55432

# Application running on your host:
DATABASE_URL=postgresql://assessment:assessment_local_only@localhost:55432/customer_insights
# Application in the same Docker Compose network:
# DATABASE_URL=postgresql://assessment:assessment_local_only@db:5432/customer_insights
